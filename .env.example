# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (per SMS di verifica telefonica)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend (per email transazionali)
RESEND_API_KEY=

# Sentry (monitoraggio errori)
SENTRY_DSN=

# Sightengine (moderazione automatica foto profilo)
# Crea un account su https://sightengine.com (free tier 500 op/mese).
# Settings → API Credentials → copia API user e API secret.
# Senza queste variabili la moderazione foto è bypassata (fail-open).
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Cifratura messaggi e echi (AES-256-GCM, application-level)
# Genera con: openssl rand -base64 32
# IMPORTANTE: salva questa chiave in 3 posti (Vercel + 1Password +
# backup offline). Se la perdi, tutti i messaggi e gli echi cifrati nel DB
# diventano illeggibili in modo irrecuperabile.
MESSAGES_ENCRYPTION_KEY=

# Cloudflare Turnstile (CAPTCHA al login)
# Crea il sito su https://dash.cloudflare.com/?to=/:account/turnstile
# Senza queste variabili la verifica CAPTCHA è bypassata (utile in dev locale).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting applicativo)
# Crea il database su https://console.upstash.com (free tier 10k req/giorno)
# Senza queste variabili il rate limiter è disattivato (utile in dev locale).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
